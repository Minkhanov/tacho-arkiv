# Tiramisu TESTNET keys. Generate fresh ones with `npm run tacho -- keys` and fund them at
# https://hub.arkiv.network/faucet. Never put a mainnet key here. Never commit .env.
TACHO_PRINCIPAL_KEY=0x...
TACHO_AGENT_KEY=0x...
TACHO_COUNTERPARTY_KEY=0x...
TACHO_FORGER_KEY=0x...

# 32-byte AES-256-GCM data key (base64url) that encrypts record details. `npm run tacho -- keys` prints one.
TACHO_DATA_KEY=

# Optional: an Arkiv Hub access key raises the public RPC rate limit. Keep it out of the browser build.
# TACHO_RPC_HTTP=https://rpc.tiramisu.db-chain.testnet.arkiv.network/<access-key>
# TACHO_RPC_WS=wss://rpc.tiramisu.db-chain.testnet.arkiv.network/<access-key>
